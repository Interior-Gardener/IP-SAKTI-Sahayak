# Copy to .env and fill in. Never commit .env. Keys stay in the API environment only.

# --- LLM providers (see docs/providers.md) ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=
VOYAGE_API_KEY=

# Role -> provider (anthropic | groq) and model id
LLM_PROVIDER_ANSWER=anthropic
LLM_MODEL_ANSWER=claude-opus-5
LLM_PROVIDER_FAST=anthropic
LLM_MODEL_FAST=claude-haiku-4-5
LLM_PROVIDER_JUDGE=anthropic
LLM_MODEL_JUDGE=claude-sonnet-5

# --- Retrieval ---
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-m3
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Language and voice ---
SPEECH_PROVIDER=bhashini
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# --- Database ---
DATABASE_URL=postgresql+psycopg://sahayak:sahayak@localhost:5432/sahayak

# --- Web (read by Vite) ---
VITE_API_URL=http://localhost:8000

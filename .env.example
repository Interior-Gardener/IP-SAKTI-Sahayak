# Copy to .env and fill in. Never commit .env. Keys stay in the API environment only.

# --- LLM providers (see docs/providers.md) ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Optional: more Groq keys, comma-separated. A long eval switches to the next one when a key
# hits its daily limit (the free tier allows 200k tokens/day per account).
GROQ_API_KEYS=
VOYAGE_API_KEY=

# Role -> provider (groq | anthropic) and model id. Groq is the default for now.
# For Anthropic: set the providers to anthropic and the models to
# claude-opus-5 / claude-haiku-4-5 / claude-sonnet-5 (or leave models blank).
LLM_PROVIDER_ANSWER=groq
LLM_MODEL_ANSWER=openai/gpt-oss-120b
LLM_PROVIDER_FAST=groq
LLM_MODEL_FAST=openai/gpt-oss-120b
LLM_PROVIDER_JUDGE=groq
LLM_MODEL_JUDGE=openai/gpt-oss-120b

# --- Retrieval ---
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-m3
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Set RERANK_PROVIDER=none to skip the ~2 GB reranker download on a laptop demo.
# BGE-M3 input cap in tokens; higher is slower on CPU.
EMBED_MAX_TOKENS=512

# --- Language and voice ---
SPEECH_PROVIDER=bhashini
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# --- Database ---
DATABASE_URL=postgresql+psycopg://sahayak:sahayak@localhost:5432/sahayak

# --- Web (read by Vite) ---
VITE_API_URL=http://localhost:8000

# Host ports for docker compose (change if something else uses them)
API_PORT=8000
POSTGRES_PORT=5432
